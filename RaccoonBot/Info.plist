<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_HOST</key>
	<string>$(API_HOST)</string>
	<key>API_PATH</key>
	<string>$(API_PATH)</string>
	<key>API_PATH_M</key>
	<string>$(API_PATH_M)</string>
	<key>API_PROTOCOL</key>
	<string>$(API_PROTOCOL)</string>
	<!-- Apple's own string, verbatim out of the shared cache:
	     "LSSupportsGameMode key not found in Info.plist. This key will become
	      required to be eligible for Game Mode in a future OS release."
	     Declared here rather than as a build setting because Xcode has no
	     INFOPLIST_KEY for it yet. -->
	<key>LSSupportsGameMode</key>
	<true/>
</dict>
</plist>
